# Discord
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here
OPERATIONS_CHANNEL_ID=your_op_channel_id_here
PUBLIC_CHANNEL_ID=your_pub_channel_id_here
TEST_CHANNEL_ID=your_test_channel_id_here
ANNOUNCE_ROLE_ID=your_announce_role_id_here
OPERATOR_ROLE_ID=your_operator_role_id_here

# X (Twitter) - 本番
X_ACCOUNT=your_x_account_here
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_SECRET=your_access_secret_here

# X (Twitter) - テスト用
TEST_X_ACCOUNT=your_test_x_account_here
TEST_X_API_KEY=your_test_api_key_here
TEST_X_API_SECRET=your_test_api_secret_here
TEST_X_ACCESS_TOKEN=your_test_access_token_here
TEST_X_ACCESS_SECRET=your_test_access_secret_here

# VRChat
# USER_AGENT は VRChat API の規約で必須。形式: "AppName/1.0 contact@example.com"
USER_AGENT=YourAppName/1.0 your@email.com
VRC_STATE_DIR=/path/to/state/dir
VRC_MAIN_USERNAME=your_vrchat_username
VRC_MAIN_PASSWORD=your_vrchat_password
VRC_MAIN_TOTP_SECRET=your_totp_secret_if_2fa_enabled
VRC_SUB_USER_ID=usr_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WORLD_ID=wrld_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_ID=grp_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEST_GROUP_ID=grp_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# INSTANCE_REGION=jp

# スケジュール (任意 - デフォルト値あり)
# CONFIRM_CRON=0 12 * * 4
# PRE_ANNOUNCE_CRON=0 19 * * 4

# LT (ライトニングトーク)
# 応募を受け付けるフォーラムチャンネル。タグは Discord 側で手動作成しておく:
#   受付中 / 日程確定 / 準備完了 / 告知済み / 登壇完了 / 取り下げ
# タグには「モデレーターのみ設定可」を付けると登壇者による付け替えを防げる（Bot に ManageThreads 権限が必要）
LT_FORUM_CHANNEL_ID=your_lt_forum_channel_id_here
TEST_LT_FORUM_CHANNEL_ID=your_test_lt_forum_channel_id_here
# 集会の開催曜日 (0=日 ... 5=金 ... 6=土)
# MEETUP_WEEKDAY=5
# 1回の集会あたりの LT 枠数（原則 1 枠）
# LT_SLOTS_PER_DAY=1
# 日程選択で提示する候補の開催回数
# LT_DATE_CANDIDATES=8
# LT_STORE_PATH=./lt-store.json
# LT_MATERIALS_DIR=./state/lt-materials
# 素材画像1枚あたりの上限MB（Discord の添付上限に合わせて調整）
# LT_MAX_MATERIAL_MB=50
# LT告知でメンションするロールID（未設定なら週次と同じ ANNOUNCE_ROLE_ID を使う）
# LT_ANNOUNCE_ROLE_ID=
# VRChatグループ掲示板のLT告知でメンバー全員に通知するか（falseにすると掲示板に載るだけ）
# LT_GROUP_POST_NOTIFY=true
# 週次フロー（木曜の事前告知・当日の開催告知）にLT告知を同乗させるか（falseにすると手動ボタンのみ）
# LT_AUTO_ANNOUNCE=true

# Storage
STORAGE_PATH=./storage.json

# Canva（司会進行スライドの PDF 配布）
# Developer Portal で Connect APIs の integration を作成して取得する
# https://www.canva.com/developers/
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
# 司会進行スライドのデザインID（Canvaの編集URL /design/<ここ>/edit）
CANVA_SLIDE_DESIGN_ID=your_canva_design_id_here
# 初回認可のコールバック先（Developer Portal に登録した値と一致させる）
# CANVA_REDIRECT_URI=http://127.0.0.1:8976/callback
# リフレッシュトークンの保存先ディレクトリ
# CANVA_STATE_DIR=./state
# 添付できるPDFの上限MB（サーバーの添付上限に合わせる）
# CANVA_MAX_PDF_MB=50
# 開催確認で「開催する」を選んだときに司会進行スライドを自動投稿するか
# CANVA_AUTO_POST_SLIDES=true
# 司会進行スライド動画（webm）の1ページあたりの表示秒数
# SLIDES_VIDEO_SECONDS=1
# 司会進行スライド動画の高さ(px)。横幅はPDFの縦横比から決まる
# SLIDES_VIDEO_HEIGHT=1080
